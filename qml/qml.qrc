<RCC>
    <qresource prefix="/qml">
        <file>Main.qml</file>
        <file>LedTile.qml</file>
        <file>Card.qml</file>
        <file>ModePill.qml</file>
        <file>DeadmanStage.qml</file>
        <file>PressButton.qml</file>
        <file>KeyCell.qml</file>
        <file>SimulatorBezel.qml</file>
        <file>PlcPage.qml</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="DejaVuSans.ttf">fonts/DejaVuSans.ttf</file>
        <file alias="DejaVuSans-Bold.ttf">fonts/DejaVuSans-Bold.ttf</file>
    </qresource>
</RCC>
